SERVER_PORT=4020
SERVER_HOST=127.0.0.1
LOG_LEVEL=info

# Required for protected /api endpoints.
TELEGRAM_CONNECTOR_API_KEY=replace-with-a-long-random-api-key

# Default secret used when POST /api/webhooks omits `secret`.
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-webhook-secret

# Optional bootstrap credentials for the initial default session only.
# Additional sessions can be added from the dashboard/API with their own values.
# Telegram app credentials come from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-api-hash

# Optional existing GramJS StringSession for the initial default session.
TELEGRAM_DEFAULT_SESSION=main
TELEGRAM_SESSION=replace-with-your-gramjs-string-session

# Public URL Inteldesk will use for media download links.
PUBLIC_BASE_URL=https://telegram-connector.example.com

# Local durable state.
SQLITE_PATH=data/telegram-connector.sqlite
MEDIA_STORAGE_DIR=media
TELEGRAM_DOWNLOAD_INBOUND_MEDIA=true

# Webhook retry behavior.
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_MS=1000
